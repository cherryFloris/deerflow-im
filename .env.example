# DeerFlow Gateway 地址。Docker 网络内为 http://gateway:8001；本地调试可为 http://localhost:8001
DEERFLOW_GATEWAY_URL=http://gateway:8001

# DeerFlow Personal Access Token（必填）。
# 在 DeerFlow Gateway 签发：POST /api/v1/auth/pats
#   body: {"name":"im-bridge","scopes":["threads:read","threads:write","runs:create","runs:read"],"expires_in_days":365}
# 响应里的 token 字段（dfp_...）即为本值。PAT 对线程/run 路由自动豁免 CSRF。
DEERFLOW_PAT=

# 管理 UI / API 端口。
# - 本地直接用 node 启动时（IM_BRIDGE_PORT）：监听端口，设为稀有端口 10010。
# - Docker 部署时容器内端口固定为 10010（nginx 以 im-bridge:10010 反代），
#   宿主机发布端口由 IM_BRIDGE_PUBLISH_PORT 控制（默认 10010）。
IM_BRIDGE_PORT=10010
IM_BRIDGE_PUBLISH_PORT=10010

# 管理写操作令牌（建议设置，否则管理接口未鉴权）
IM_BRIDGE_ADMIN_TOKEN=

# 凭证加密密钥（强烈建议设置；未设置则凭证仅做 base64 混淆存储）
IM_BRIDGE_SECRET=

# 持久化数据目录（Docker 中挂载卷）
IM_BRIDGE_DATA_DIR=./data

# 默认递归上限（DeerFlow 会 clamp 到 <=1000）
IM_BRIDGE_RECURSION_LIMIT=100

IM_BRIDGE_LOG_LEVEL=info
